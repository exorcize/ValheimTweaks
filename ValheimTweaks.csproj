<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>ValheimTweaks</AssemblyName>
    <RootNamespace>ValheimTweaks</RootNamespace>
    <Version>0.33.7</Version>
    <LangVersion>latest</LangVersion>
    <!-- The game loads the DLL; we don't want transitive deps or extra files. -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <DebugType>portable</DebugType>
    <!-- Unity/Mono doesn't understand annotated nullable refs; turn off the noise. -->
    <Nullable>disable</Nullable>
    <NoWarn>$(NoWarn);CS0649;CS0169</NoWarn>
  </PropertyGroup>

  <!-- Local paths. If Steam/r2modman move, just adjust them here. -->
  <PropertyGroup>
    <ValheimDir Condition="'$(ValheimDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Valheim</ValheimDir>
    <ManagedDir>$(ValheimDir)\valheim_Data\Managed</ManagedDir>
    <ProfileDir Condition="'$(ProfileDir)' == ''">$(AppData)\r2modmanPlus-local\Valheim\profiles\Default</ProfileDir>
    <BepInExCore>$(ProfileDir)\BepInEx\core</BepInExCore>
    <!-- Folder created by r2modman when importing the zip as a "local mod". The author
         shows up as "Unknown" because a local manifest has no Thunderstore namespace.
         It must point HERE: if the deploy went to its own folder, BepInEx would load
         both and we'd be editing one copy while the game runs the other. -->
    <PluginDir>$(ProfileDir)\BepInEx\plugins\Unknown-ValheimTweaks</PluginDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- BepInEx + HarmonyX, straight from the r2modman profile (no NuGet). -->
    <Reference Include="BepInEx">
      <HintPath>$(BepInExCore)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExCore)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Game code. Assembly-CSharp.dll is a 23 KB stub: the game is here. -->
    <Reference Include="assembly_valheim">
      <HintPath>$(ManagedDir)\assembly_valheim.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_utils">
      <HintPath>$(ManagedDir)\assembly_utils.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- PostProcessing v1 (FXAA/TAA/bloom). The game only toggles it; we configure it. -->
    <Reference Include="assembly_postprocessing">
      <HintPath>$(ManagedDir)\assembly_postprocessing.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Unity. Compiling against the game's real DLLs = a compile error
         if the API doesn't exist in this version (Unity 6000.0.75f1). -->
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(ManagedDir)\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Localization: an item's m_name is a token ("$item_feathers"). -->
    <Reference Include="assembly_guiutils">
      <HintPath>$(ManagedDir)\assembly_guiutils.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- TextAnchor, used by the layout groups. -->
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(ManagedDir)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- CanvasGroup / RectTransform. -->
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(ManagedDir)\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Text of the stored items list. -->
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(ManagedDir)\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Image/Button of the inventory slots. -->
    <Reference Include="UnityEngine.UI">
      <HintPath>$(ManagedDir)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Build = deploy. It drops straight into the r2modman profile.

       r2modman disables a mod by renaming EVERY file in the folder to .old
       (seen with Azumatt-AzuCraftyBoxes: AzuCraftyBoxes.dll.old, manifest.json.old...).
       If we copied the DLL over that, the mod would silently start loading again
       while the manager still shows "disabled", and the person would be left
       wondering why the mod came back to life. So the deploy respects the toggle. -->
  <Target Name="DeployToProfile" AfterTargets="Build" Condition="Exists('$(ProfileDir)')">
    <PropertyGroup>
      <ModDisabled Condition="Exists('$(PluginDir)\$(AssemblyName).dll.old')">true</ModDisabled>
    </PropertyGroup>

    <Message Importance="high" Condition="'$(ModDisabled)' == 'true'"
             Text="  -&gt; deploy SKIPPED: mod is disabled in r2modman (found $(AssemblyName).dll.old). Re-enable it there to start receiving builds again." />

    <MakeDir Directories="$(PluginDir)" Condition="'$(ModDisabled)' != 'true'" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PluginDir)"
          ContinueOnError="true" Condition="'$(ModDisabled)' != 'true'" />

    <!-- r2modman shows the version from manifest.json, not the DLL's. Copying only the
         DLL left the mod list frozen at the version from the first import (0.15.0
         here) while the game ran a much newer one, and the mismatch between the two
         screens bred suspicion of a duplicate mod, which is a real and similar-looking
         problem. Rewriting the manifest on deploy keeps both honest. -->
    <WriteLinesToFile File="$(PluginDir)\manifest.json" Overwrite="true" Encoding="UTF-8"
                      Condition="'$(ModDisabled)' != 'true'"
                      Lines="{&quot;name&quot;:&quot;ValheimTweaks&quot;,&quot;version_number&quot;:&quot;$(Version)&quot;,&quot;website_url&quot;:&quot;&quot;,&quot;description&quot;:&quot;Video, network and quality-of-life tweaks for Valheim.&quot;,&quot;dependencies&quot;:[&quot;denikson-BepInExPack_Valheim-5.4.2350&quot;,&quot;shudnal-ConfigurationManager-1.1.18&quot;]}" />

    <Message Importance="high" Condition="'$(ModDisabled)' != 'true'"
             Text="  -&gt; deploy: $(PluginDir)\$(AssemblyName).dll (manifest -&gt; $(Version))" />
  </Target>

</Project>
