<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>ValheimTweaks</AssemblyName>
    <RootNamespace>ValheimTweaks</RootNamespace>
    <Version>0.27.0</Version>
    <LangVersion>latest</LangVersion>
    <!-- O jogo carrega o DLL; nao queremos deps transitivas nem arquivos extras. -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <DebugType>portable</DebugType>
    <!-- Unity/Mono nao entende nullable refs anotados; desliga o ruido. -->
    <Nullable>disable</Nullable>
    <NoWarn>$(NoWarn);CS0649;CS0169</NoWarn>
  </PropertyGroup>

  <!-- Caminhos locais. Se o Steam/r2modman mudarem de lugar, e so ajustar aqui. -->
  <PropertyGroup>
    <ValheimDir Condition="'$(ValheimDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Valheim</ValheimDir>
    <ManagedDir>$(ValheimDir)\valheim_Data\Managed</ManagedDir>
    <ProfileDir Condition="'$(ProfileDir)' == ''">$(AppData)\r2modmanPlus-local\Valheim\profiles\Default</ProfileDir>
    <BepInExCore>$(ProfileDir)\BepInEx\core</BepInExCore>
    <!-- Pasta criada pelo r2modman ao importar o zip como "local mod". O autor sai
         como "Unknown" porque manifest local nao tem namespace do Thunderstore.
         Precisa apontar AQUI: se o deploy for para uma pasta propria, o BepInEx
         carrega as duas e a gente edita uma copia enquanto o jogo roda a outra. -->
    <PluginDir>$(ProfileDir)\BepInEx\plugins\Unknown-ValheimTweaks</PluginDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- BepInEx + HarmonyX, direto do perfil do r2modman (sem NuGet). -->
    <Reference Include="BepInEx">
      <HintPath>$(BepInExCore)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExCore)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Codigo do jogo. Assembly-CSharp.dll e um stub de 23 KB: o jogo esta aqui. -->
    <Reference Include="assembly_valheim">
      <HintPath>$(ManagedDir)\assembly_valheim.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_utils">
      <HintPath>$(ManagedDir)\assembly_utils.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- PostProcessing v1 (FXAA/TAA/bloom). O jogo so liga/desliga; a gente configura. -->
    <Reference Include="assembly_postprocessing">
      <HintPath>$(ManagedDir)\assembly_postprocessing.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Unity. Compilar contra os DLLs reais do jogo = erro de compilacao
         se a API nao existir nesta versao (Unity 6000.0.75f1). -->
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(ManagedDir)\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Localization: m_name de item e um token ("$item_feathers"). -->
    <Reference Include="assembly_guiutils">
      <HintPath>$(ManagedDir)\assembly_guiutils.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- TextAnchor, usado pelos layout groups. -->
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(ManagedDir)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- CanvasGroup / RectTransform. -->
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(ManagedDir)\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Texto da lista de itens guardados. -->
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(ManagedDir)\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Image/Button dos slots de inventario. -->
    <Reference Include="UnityEngine.UI">
      <HintPath>$(ManagedDir)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Build = deploy. Cai direto no perfil do r2modman.

       O r2modman desabilita um mod renomeando TODO arquivo da pasta para .old
       (visto em Azumatt-AzuCraftyBoxes: AzuCraftyBoxes.dll.old, manifest.json.old...).
       Se copiassemos o DLL por cima disso, o mod voltaria a carregar em silencio
       enquanto o gerenciador ainda mostra "desabilitado", e a pessoa ficaria
       procurando por que o mod ressuscitou. Entao o deploy respeita o toggle. -->
  <Target Name="DeployToProfile" AfterTargets="Build" Condition="Exists('$(ProfileDir)')">
    <PropertyGroup>
      <ModDisabled Condition="Exists('$(PluginDir)\$(AssemblyName).dll.old')">true</ModDisabled>
    </PropertyGroup>

    <Message Importance="high" Condition="'$(ModDisabled)' == 'true'"
             Text="  -&gt; deploy PULADO: mod esta desabilitado no r2modman (encontrado $(AssemblyName).dll.old). Reabilite la para voltar a receber builds." />

    <MakeDir Directories="$(PluginDir)" Condition="'$(ModDisabled)' != 'true'" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PluginDir)"
          ContinueOnError="true" Condition="'$(ModDisabled)' != 'true'" />
    <Message Importance="high" Condition="'$(ModDisabled)' != 'true'"
             Text="  -&gt; deploy: $(PluginDir)\$(AssemblyName).dll" />
  </Target>

</Project>
